{
  "name": "@joinbankroll/sdk",
  "version": "0.7.0",
  "description": "Build on Bankroll — typed client for the window.bankroll bridge, plus server-side session verification, charge confirmation, and payouts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inplayinnovation/bankroll-sdk.git"
  },
  "homepage": "https://joinbankroll.com",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./privy": {
      "types": "./dist/privy.d.ts",
      "import": "./dist/privy.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./store/fs": {
      "types": "./dist/store/fs.d.ts",
      "import": "./dist/store/fs.js"
    },
    "./store/vercel": {
      "types": "./dist/store/vercel.d.ts",
      "import": "./dist/store/vercel.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/verify-build.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "jose": "^6.0.0"
  },
  "peerDependencies": {
    "@privy-io/node": "^0.10.1",
    "@vercel/blob": "^2.0.0",
    "next": ">=15",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@privy-io/node": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@vercel/blob": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@privy-io/node": "^0.10.1",
    "@solana/spl-token": "^0.4.15",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.6.1",
    "happy-dom": "^18.0.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.5.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "uuid": "^11.0.0"
  }
}
